# ============================================================
#  BnaSalud – .gitignore raíz (cubre portal público e interno)
# ============================================================

# Entorno virtual Python
venv/
.venv/
.venv*/

# Variables de entorno / secretos
.env
.env.*
!.env.example

# Credenciales locales
Cred_hash.txt
CREDENCIALES.md
interno/CREDENCIALES.md

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Frontend
node_modules/
dist/
.vite/
.expo/

# Build Android (Capacitor) — no versionar assets compilados
interno/frontend/android/

# Volcados de base de datos y exportaciones locales
dump-bnasalud-*.sql
interno/dump-bnasalud-*.sql
*.xlsx
*.csv
*.db
*.sqlite3

# Scripts y artefactos de QA local
qa-e2e.ps1
QA-E2E-log.json
interno/qa-e2e.ps1
interno/QA-E2E-log.json

# Logs
*.log

# IDE
.vscode/
.idea/

# Sistema operativo
.DS_Store
Thumbs.db

# Evolution API clonado localmente (no se versiona)
evolution-api/

# Carpetas sueltas de imágenes provisionales
Nueva carpeta/

# Tooling de agentes (configuración local)
.agents/
skills-lock.json
.kiro/
