# Configuración General
PROJECT_NAME="Sistema de Salud Barcelona - API Backend"
API_V1_STR="/api/v1"

# Supabase Credentials (Panel Supabase -> Project Settings -> API)
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_KEY="eyJ... (anon public key)"

# Conexión directa a Postgres (solo la usa Evolution API local vía npm; el backend no la lee).
# Panel Supabase -> Project Settings -> Database -> Connection string (pooler, rellena el password).
SUPABASE_DB_URI="postgresql://postgres.<TU-REF>:<PASSWORD>@<TU-HOST>.pooler.supabase.com:5432/postgres"

# Google AI Studio / Gemini API Key (Obtenla en https://aistudio.google.com/)
GOOGLE_API_KEY=""

# WhatsApp — Evolution API (local vía npm / contenedor en GCP)
# URL donde corre Evolution API localmente
EVOLUTION_API_URL="http://localhost:8080"
# Debe coincidir con AUTHENTICATION_API_KEY de Evolution (misma en GCP)
EVOLUTION_API_KEY=""
# Nombre de la instancia que crearás en el panel de Evolution API
EVOLUTION_INSTANCE_NAME="bnasalud"

# Opcional — JWT (si no la defines se usa el default del código; defínela en producción)
# JWT_SECRET="un-secreto-muy-largo-cambialo-en-produccion"