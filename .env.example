# =============================================================================
# BnaSalud — Plantilla de variables de entorno
# -----------------------------------------------------------------------------
# Copia este archivo a .env y completa tus credenciales reales:
#   Windows:  copy .env.example .env
#   Linux/macOS:  cp .env.example .env
#
# NUNCA subas el archivo .env al repositorio (contiene secretos).
# =============================================================================

# --- Base de datos (Supabase) ------------------------------------------------
# El backend lee y escribe los datos a través del cliente de Supabase.
# Son las dos variables imprescindibles: sin ellas la API arranca pero
# todas las consultas a datos fallan.
SUPABASE_URL="https://TU-PROYECTO.supabase.co"
SUPABASE_KEY="TU-ANON-KEY"

# Cadena de conexión directa a PostgreSQL. La usan scripts/restore_db.py y
# docker-compose.yml (Evolution API). Opcional según el entorno.
# SUPABASE_DB_URI="postgresql://postgres:TU-PASSWORD@db.TU-PROYECTO.supabase.co:5432/postgres"

# --- IA / RAG (opcional) -----------------------------------------------------
GOOGLE_API_KEY=""

# --- Autenticación (JWT) -----------------------------------------------------
JWT_SECRET="cambiar-en-produccion-por-un-secreto-largo"
JWT_ALGORITHM="HS256"
JWT_EXPIRACION_MINUTOS=480

# --- Recuperación de PIN del paciente ---------------------------------------
PIN_EXPIRACION_MINUTOS=15
# true = devuelve el código en la respuesta de la API (solo desarrollo, sin SMTP)
PIN_EMITIR_DEMO=true

# --- SMTP (opcional): bienvenida y recuperación de PIN por correo -----------
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_USE_TLS=true

# --- WhatsApp / Evolution API (opcional) ------------------------------------
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE_NAME="bnasalud"
